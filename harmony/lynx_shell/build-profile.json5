{
  "apiType": "stageMode",
  "buildOptionSet": [
    {
      "name": "debug",
      "arkOptions": {
        "runtimeOnly": {
          "packages": ["@lynx/lynx_devtool"]
        }
      }
    },
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": ["./obfuscation-rules.txt"]
          }
        }
      }
    }
  ],
  "targets": [
    { "name": "default" },
    { "name": "ohosTest" }
  ]
}
