source 'https://cdn.cocoapods.org/'
source 'https://github.com/lynx-family/Specs.git'
platform :ios, '14.0'

use_modular_headers!
use_frameworks! :linkage => :static

project 'LynxShell.xcodeproj'

# CocoaPods 的配置过滤不会隔离共享 Pod 的调试 subspec，开发/生产必须分别解析。
# 开发默认包含调试依赖；生产构建前执行 LYNX_DEVTOOLS=0 pod install。
devtools_mode = ENV.fetch('LYNX_DEVTOOLS', '1')
raise 'LYNX_DEVTOOLS 只能为 0 或 1' unless ['0', '1'].include?(devtools_mode)
devtools_enabled = devtools_mode == '1'

target 'LynxShell' do
  # Shell 负责 Router/Runtime；地图实现由独立 LynxMapKit Module 提供。
  pod 'LynxShellKit', :path => '.'
  pod 'LynxMapKit', :path => 'LynxMapKit'
  # AMap 官方 CocoaPods CDN 尚未同步 2.12.3，使用官方下载包的本地 podspec 固定版本。
  pod 'AMapLocation', :podspec => 'LocalPods/AMapLocation.podspec'
  # 仅 Debug 构建链接端内调试工具；Release 不包含 DebugKit、面板或诊断缓存。
  pod 'LynxShellDebugKit', :path => '.', :configurations => ['Debug']

  if devtools_enabled
    pod 'LynxService/Devtool', '4.1.0'
    pod 'LynxDevtool', '4.1.0'
    pod 'DebugRouter', '5.0.15'
    pod 'DebugRouter/MessageTransceiverEnable', '5.0.15'
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      if ['LynxShellKit', 'LynxShellDebugKit'].include?(target.name)
        if config.name == 'Debug'
          # Pod 与 App 分别编译，显式保证诊断源码只在 Pod 的 Debug 配置可用。
          config.build_settings['SWIFT_ACTIVE_COMPILATION_CONDITIONS'] = '$(inherited) DEBUG'
        else
          # 生产编译任务不读取真实诊断源码；公共调用点另由 #if DEBUG 一并移除。
          excluded = target.name == 'LynxShellKit' ? ['LynxDebugBridge.swift'] : ['*.swift', 'LynxDebugHttpCapture.m']
          config.build_settings['EXCLUDED_SOURCE_FILE_NAMES'] = ['$(inherited)'] + excluded
        end
      end
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      disable = ['-Wno-error', '-Wno-c99-designator',
                 '-Wno-deprecated-declarations', '-Wno-deprecated-implementations',
                 '-Wno-error=unused-result']
      ['OTHER_CPLUSPLUSFLAGS', 'OTHER_CFLAGS'].each do |key|
        flags = config.build_settings[key] || ['$(inherited)']
        flags = [flags] unless flags.is_a?(Array)
        config.build_settings[key] = flags + disable
      end
    end
  end
end
