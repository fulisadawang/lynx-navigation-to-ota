{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lynx-router.invalid/schemas/telemetry/event-envelope-3.0.0.schema.json",
  "title": "Lynx Router Telemetry Event Envelope",
  "description": "Wire Schema 3.0.0。只允许已经脱敏、限长、采样后的事件进入交付层。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventName",
    "category",
    "source",
    "occurredAtUnixMs",
    "monotonicOffsetMs",
    "sequenceNo",
    "runtimeKind",
    "runtimeInstanceId",
    "telemetryRouteKey",
    "hostMode",
    "platform",
    "hostApp",
    "appVersion",
    "buildNumber",
    "lynxSdkVersion",
    "engineVersion",
    "sampleRate",
    "samplingGroup",
    "samplingRuleVersion",
    "analysisEligible",
    "deliveryOwner",
    "attributes"
  ],
  "properties": {
    "schemaVersion": { "const": "3.0.0" },
    "eventId": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]{8,128}$" },
    "eventName": {
      "type": "string",
      "enum": [
        "lynx.navigation.requested",
        "lynx.navigation.rejected",
        "lynx.navigation.accepted",
        "lynx.page.identity_created",
        "lynx.page.container_init_start",
        "lynx.page.container_init_end",
        "lynx.page.load_started",
        "lynx.page.runtime_ready",
        "lynx.page.first_screen",
        "lynx.page.business_ready",
        "lynx.page.visibility_changed",
        "lynx.page.activation_started",
        "lynx.page.activation_ended",
        "lynx.page.destroyed",
        "lynx.page.failed",
        "lynx.transition.state_changed",
        "lynx.transition.terminal",
        "sampled_page_view",
        "app.lifecycle.changed",
        "lynx.performance.load_bundle",
        "lynx.performance.reload_bundle",
        "lynx.performance.pipeline",
        "lynx.performance.lazy_bundle",
        "lynx.resource.completed",
        "lynx.runtime.memory_pressure",
        "lynx.background_runtime.started",
        "lynx.background_runtime.evaluate_completed",
        "lynx.background_runtime.destroyed",
        "lynx.error.runtime",
        "lynx.error.javascript",
        "lynx.error.native",
        "lynx.error.resource",
        "lynx.bridge.invoked",
        "lynx.bridge.completed",
        "lynx.bridge.failed",
        "lynx.exposure.qualified",
        "lynx.exposure.ended",
        "lynx.exposure.resume_requested",
        "lynx.business.event",
        "lynx.business.click",
        "ota.check",
        "ota.download",
        "ota.verify",
        "ota.activate",
        "ota.page_open",
        "ota.rollback",
        "telemetry.events_dropped_summary",
        "telemetry.stale_callback_dropped",
        "open_interval_abandoned"
      ]
    },
    "category": {
      "type": "string",
      "enum": ["router", "navigation", "page", "app", "transition", "performance", "resource", "runtime", "error", "bridge", "exposure", "business", "ota", "diagnostic", "telemetry"]
    },
    "source": { "type": "string", "enum": ["native", "lynx_runtime", "background_runtime", "system"] },
    "occurredAtUnixMs": { "type": "integer", "minimum": 0 },
    "monotonicOffsetMs": { "type": "integer", "minimum": 0 },
    "sequenceNo": { "type": "integer", "minimum": 0 },
    "navigationId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "navigationSessionId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "pageViewId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "entryId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "renderAttemptId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "activationId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "transactionId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "otaOperationId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "runtimeKind": { "type": "string", "enum": ["lynx_view", "background_runtime"] },
    "runtimeInstanceId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "runtimeGeneration": { "type": ["integer", "null"], "minimum": 1 },
    "telemetryRouteKey": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,128}$" },
    "hostMode": { "type": "string", "enum": ["activity", "view_controller", "arkui_page"] },
    "platform": { "type": "string", "enum": ["android", "ios", "harmony"] },
    "hostApp": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,96}$" },
    "appVersion": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,64}$" },
    "buildNumber": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,64}$" },
    "lynxSdkVersion": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,64}$" },
    "engineVersion": { "type": "string", "pattern": "^[A-Za-z0-9._+-]{1,64}$" },
    "attemptedBundleSnapshot": { "$ref": "#/$defs/attemptedBundleSnapshot" },
    "resolvedBundleSnapshot": { "$ref": "#/$defs/resolvedBundleSnapshot" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "navigationAdmission": { "$ref": "#/$defs/navigationAdmission" },
    "transition": { "$ref": "#/$defs/transition" },
    "exposure": { "$ref": "#/$defs/exposure" },
    "sampleRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "samplingGroup": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$" },
    "samplingRuleVersion": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$" },
    "inclusionProbability": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "analysisEligible": { "type": "boolean" },
    "samplingReason": { "type": ["string", "null"], "enum": ["stable_cohort", "forced_diagnostic", "not_sampled", null] },
    "deliveryOwner": { "type": "string", "enum": ["internal", "external"] },
    "privacy": { "$ref": "#/$defs/privacy" },
    "attributes": { "type": "object", "maxProperties": 32 }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "routeKey": { "type": "string", "pattern": "^[A-Za-z0-9._/-]{1,128}$" },
    "bundleSource": { "type": "string", "enum": ["ota", "direct_https", "assets", "local_file"] },
    "attemptedBundleSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "bundleSource", "bundleName", "telemetryRouteKey", "prepareStartedAtUnixMs", "attemptGeneration"],
      "properties": {
        "kind": { "const": "attempted" },
        "bundleSource": { "$ref": "#/$defs/bundleSource" },
        "lynxAppId": { "type": ["string", "null"], "pattern": "^[0-9A-Za-z._-]{1,64}$" },
        "bundleName": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}\\.lynx\\.bundle$" },
        "telemetryRouteKey": { "$ref": "#/$defs/routeKey" },
        "otaOperationId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "candidateReleaseId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "expectedSha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
        "prepareStartedAtUnixMs": { "type": "integer", "minimum": 0 },
        "attemptGeneration": { "type": "integer", "minimum": 1 }
      }
    },
    "resolvedBundleSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "bundleSource", "bundleName", "telemetryRouteKey", "resolvedAtUnixMs"],
      "properties": {
        "kind": { "const": "resolved" },
        "bundleSource": { "$ref": "#/$defs/bundleSource" },
        "lynxAppId": { "type": ["string", "null"], "pattern": "^[0-9A-Za-z._-]{1,64}$" },
        "bundleName": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}\\.lynx\\.bundle$" },
        "telemetryRouteKey": { "$ref": "#/$defs/routeKey" },
        "releaseId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "bundleSha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
        "engineVersion": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._+-]{1,64}$" },
        "localGeneration": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "rollbackFromReleaseId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "resolvedAtUnixMs": { "type": "integer", "minimum": 0 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageState", "appState", "attemptState", "activeEligible"],
      "properties": {
        "pageState": { "type": "string", "enum": ["allocated", "registered", "visible", "hidden", "destroyed"] },
        "appState": { "type": "string", "enum": ["foreground", "background"] },
        "attemptState": { "type": "string", "enum": ["unusable", "usable"] },
        "activeEligible": { "type": "boolean" },
        "reason": { "type": ["string", "null"], "enum": ["coveredByPage", "detached", "configurationChange", "appForeground", "appBackground", "destroyed", "reload", null] }
      }
    },
    "navigationAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "type": "string", "enum": ["requested", "accepted", "rejected"] },
        "rejectionCode": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,64}$" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "type": "string", "enum": ["waitingTarget", "running", "settling", "terminal"] },
        "terminal": { "type": ["string", "null"], "enum": ["completed", "degraded", "cancelled", "failed", "notApplicable", null] },
        "durationMs": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exposureKey", "contentId", "exposureSessionId", "occurrence", "visibleRatioThreshold", "minDurationMs", "ruleVersion", "observerGeneration"],
      "properties": {
        "exposureKey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "contentId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "exposureSessionId": { "$ref": "#/$defs/safeId" },
        "position": { "type": ["integer", "null"], "minimum": 0 },
        "occurrence": { "type": "integer", "minimum": 1 },
        "reportOnce": { "type": "boolean" },
        "visibleRatioThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxVisibleRatio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "minDurationMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "durationMs": { "type": ["integer", "null"], "minimum": 0, "maximum": 86400000 },
        "ruleVersion": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$" },
        "endReason": { "type": ["string", "null"], "enum": ["ratio_drop", "covered", "background", "destroyed", "reload", "item_recycled", null] },
        "observerGeneration": { "type": "integer", "minimum": 1 }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consentState", "subjectRefPresent"],
      "properties": {
        "consentState": { "type": "string", "enum": ["granted", "denied", "unknown"] },
        "subjectRefPresent": { "type": "boolean" },
        "optOut": { "type": "boolean" }
      }
    }
  }
}
